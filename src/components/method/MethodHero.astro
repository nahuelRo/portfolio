---
import { methodPage } from "../../data/method";
---

<section class="section-y border-b border-line/50">
  <div class="mx-auto max-w-3xl px-5">
    <p
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent"
    >
      {methodPage.hero.eyebrow}
    </p>
    <h1
      class="font-display mt-4 max-w-2xl text-3xl font-semibold tracking-tight md:text-5xl"
    >
      {methodPage.hero.title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
      {methodPage.hero.subtitle}
    </p>
  </div>
</section>
