---
import type { MethodVisual } from "../../data/method";

interface Props {
  kind: MethodVisual;
}

const { kind } = Astro.props;
---

<div class="method-visual" data-visual={kind} aria-hidden="true">
  {
    kind === "operation" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <path
          class="mv-line"
          d="M40 100 H120 M120 100 L160 60 M120 100 L160 140 M160 60 H260 M160 140 H260"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <circle class="mv-node mv-a" cx="40" cy="100" r="14" />
        <circle class="mv-node mv-b" cx="120" cy="100" r="14" />
        <circle class="mv-node mv-c" cx="160" cy="60" r="12" />
        <circle class="mv-node mv-d" cx="160" cy="140" r="12" />
        <rect class="mv-box mv-e" x="248" y="44" width="48" height="32" rx="8" />
        <rect class="mv-box mv-f" x="248" y="124" width="48" height="32" rx="8" />
        <text x="40" y="104" text-anchor="middle" class="mv-label">
          Op
        </text>
      </svg>
    )
  }
  {
    kind === "data" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <rect class="mv-box mv-a" x="36" y="36" width="100" height="56" rx="10" />
        <rect class="mv-box mv-b" x="184" y="36" width="100" height="56" rx="10" />
        <rect class="mv-box mv-c" x="110" y="120" width="100" height="56" rx="10" />
        <path
          class="mv-line"
          d="M136 92 V120 M184 64 H160 M160 64 V120"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <text x="86" y="70" text-anchor="middle" class="mv-label">
          Entity
        </text>
        <text x="234" y="70" text-anchor="middle" class="mv-label">
          Entity
        </text>
        <text x="160" y="154" text-anchor="middle" class="mv-label">
          Relation
        </text>
      </svg>
    )
  }
  {
    kind === "permissions" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <rect class="mv-box mv-a" x="24" y="40" width="120" height="120" rx="14" />
        <rect class="mv-box mv-b" x="176" y="40" width="120" height="120" rx="14" />
        <circle class="mv-node mv-c" cx="64" cy="88" r="10" />
        <circle class="mv-node mv-d" cx="104" cy="88" r="10" />
        <circle class="mv-node mv-e" cx="216" cy="88" r="10" />
        <circle class="mv-node mv-f" cx="256" cy="88" r="10" />
        <path
          class="mv-line mv-block"
          d="M144 100 H176"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-dasharray="4 4"
        />
        <text x="84" y="148" text-anchor="middle" class="mv-label">
          Tenant A
        </text>
        <text x="236" y="148" text-anchor="middle" class="mv-label">
          Tenant B
        </text>
      </svg>
    )
  }
  {
    kind === "stack" && (
      <div class="grid h-full grid-cols-3 gap-2 p-4">
        {["TS", "Next", "Nest", "Vue", "PG", "AWS"].map((item, i) => (
          <div
            class:list={["mv-chip", `mv-delay-${i}`]}
          >
            {item}
          </div>
        ))}
      </div>
    )
  }
  {
    kind === "ui" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <rect class="mv-box mv-a" x="40" y="28" width="240" height="144" rx="14" />
        <rect class="mv-box mv-b" x="56" y="48" width="120" height="12" rx="4" />
        <rect class="mv-box mv-c" x="56" y="72" width="208" height="48" rx="8" />
        <rect class="mv-box mv-d" x="56" y="136" width="72" height="20" rx="10" />
        <rect class="mv-box mv-e" x="140" y="136" width="72" height="20" rx="10" />
      </svg>
    )
  }
  {
    kind === "api" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <rect class="mv-box mv-a" x="24" y="70" width="80" height="60" rx="12" />
        <rect class="mv-box mv-b" x="120" y="70" width="80" height="60" rx="12" />
        <rect class="mv-box mv-c" x="216" y="70" width="80" height="60" rx="12" />
        <path
          class="mv-line mv-pulse"
          d="M104 100 H120 M200 100 H216"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <text x="64" y="106" text-anchor="middle" class="mv-label">
          UI
        </text>
        <text x="160" y="106" text-anchor="middle" class="mv-label">
          API
        </text>
        <text x="256" y="106" text-anchor="middle" class="mv-label">
          Ext
        </text>
      </svg>
    )
  }
  {
    kind === "testing" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <path
          class="mv-line"
          d="M48 140 C90 140, 90 60, 160 60 S230 140, 272 140"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <circle class="mv-node mv-a" cx="48" cy="140" r="8" />
        <circle class="mv-node mv-b" cx="160" cy="60" r="8" />
        <circle class="mv-node mv-c" cx="272" cy="140" r="8" />
        <circle class="mv-check mv-d" cx="200" cy="110" r="14" fill="none" stroke="currentColor" stroke-width="2" />
        <path
          class="mv-check mv-e"
          d="M192 110 L198 116 L210 102"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
      </svg>
    )
  }
  {
    kind === "cicd" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <rect class="mv-box mv-a" x="20" y="80" width="56" height="40" rx="8" />
        <rect class="mv-box mv-b" x="94" y="80" width="56" height="40" rx="8" />
        <rect class="mv-box mv-c" x="168" y="80" width="56" height="40" rx="8" />
        <rect class="mv-box mv-d" x="242" y="80" width="56" height="40" rx="8" />
        <path
          class="mv-line mv-pulse"
          d="M76 100 H94 M150 100 H168 M224 100 H242"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <text x="48" y="105" text-anchor="middle" class="mv-label">
          Build
        </text>
        <text x="122" y="105" text-anchor="middle" class="mv-label">
          Check
        </text>
        <text x="196" y="105" text-anchor="middle" class="mv-label">
          Ship
        </text>
        <text x="270" y="105" text-anchor="middle" class="mv-label">
          Live
        </text>
      </svg>
    )
  }
  {
    kind === "maintenance" && (
      <svg viewBox="0 0 320 200" class="h-full w-full">
        <circle
          class="mv-ring mv-a"
          cx="160"
          cy="100"
          r="54"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <circle
          class="mv-ring mv-b"
          cx="160"
          cy="100"
          r="34"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-dasharray="8 6"
        />
        <circle class="mv-node mv-c" cx="160" cy="100" r="10" />
        <circle class="mv-node mv-d" cx="160" cy="46" r="7" />
        <circle class="mv-node mv-e" cx="206" cy="128" r="7" />
        <circle class="mv-node mv-f" cx="114" cy="128" r="7" />
      </svg>
    )
  }
</div>

<style>
  .method-visual {
    color: var(--accent);
    height: 100%;
    min-height: 180px;
    border: 1px solid var(--stroke);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface-elevated) 88%, transparent);
    overflow: hidden;
  }

  .mv-box {
    fill: color-mix(in oklab, var(--surface) 70%, transparent);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .mv-node {
    fill: color-mix(in oklab, var(--accent) 25%, var(--surface));
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .mv-label {
    fill: var(--fg-muted);
    font-size: 11px;
    font-family: var(--font-sans);
  }

  .mv-line {
    opacity: 0.7;
  }

  .mv-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 1px solid var(--stroke);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(6px);
  }

  .is-active .mv-chip {
    animation: chip-in 0.45s ease forwards;
  }

  .is-active .mv-delay-0 {
    animation-delay: 0.05s;
  }
  .is-active .mv-delay-1 {
    animation-delay: 0.1s;
  }
  .is-active .mv-delay-2 {
    animation-delay: 0.15s;
  }
  .is-active .mv-delay-3 {
    animation-delay: 0.2s;
  }
  .is-active .mv-delay-4 {
    animation-delay: 0.25s;
  }
  .is-active .mv-delay-5 {
    animation-delay: 0.3s;
  }

  .is-active .mv-a {
    animation: pop 0.45s ease both;
  }
  .is-active .mv-b {
    animation: pop 0.45s ease 0.08s both;
  }
  .is-active .mv-c {
    animation: pop 0.45s ease 0.16s both;
  }
  .is-active .mv-d {
    animation: pop 0.45s ease 0.24s both;
  }
  .is-active .mv-e {
    animation: pop 0.45s ease 0.32s both;
  }
  .is-active .mv-f {
    animation: pop 0.45s ease 0.4s both;
  }

  .is-active .mv-pulse {
    animation: pulse-line 1.4s ease infinite;
  }

  .is-active .mv-ring {
    animation: spin-slow 12s linear infinite;
    transform-origin: 160px 100px;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes chip-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-line {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-chip,
    .is-active .mv-a,
    .is-active .mv-b,
    .is-active .mv-c,
    .is-active .mv-d,
    .is-active .mv-e,
    .is-active .mv-f,
    .is-active .mv-pulse,
    .is-active .mv-ring,
    .is-active .mv-chip {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
