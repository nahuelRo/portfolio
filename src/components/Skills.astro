---
import { site } from "../data/site";
---

<section
  id="skills"
  class="section-y border-b border-line/50"
  aria-labelledby="skills-heading"
>
  <div class="mx-auto max-w-3xl px-5">
    <h2
      id="skills-heading"
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent"
    >
      Skills
    </h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        site.skills.map((group) => (
          <div>
            <h3 class="font-display text-base font-semibold text-cream">
              {group.category}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md border border-line bg-ink-elevated px-2.5 py-1 text-sm text-muted">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
