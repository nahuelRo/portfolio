---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"projects">[];
}

const { items } = Astro.props;

const statusLabel: Record<string, string> = {
  live: "Demo",
  "coming-soon": "Próximamente",
  "case-only": "Caso de estudio",
};
---

<section
  id="proyectos"
  class="section-y border-b border-line/50"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-3xl px-5">
    <h2
      id="projects-heading"
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent"
    >
      Proyectos
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      Productos propios con demo y casos laborales documentados sin exponer
      código ni datos de clientes.
    </p>

    <ul class="mt-10 grid gap-5">
      {
        items.map((project) => (
          <li class="group rounded-2xl border border-line bg-ink-elevated/70 p-5 transition duration-200 hover:border-accent/50 hover:bg-ink-soft/80 md:p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="text-xs font-medium uppercase tracking-wider text-accent">
                  {statusLabel[project.data.status]}
                </p>
                <h3 class="font-display mt-1 text-xl font-semibold text-cream">
                  {project.data.title}
                </h3>
                {project.data.period && (
                  <p class="mt-1 text-sm text-muted">{project.data.period}</p>
                )}
              </div>
              <div class="flex flex-wrap gap-2">
                {project.data.caseUrl && (
                  <a
                    href={project.data.caseUrl}
                    class="rounded-full border border-line px-3 py-1 text-xs font-medium text-cream transition hover:border-accent hover:text-accent-soft"
                  >
                    Caso
                  </a>
                )}
                {project.data.demoUrl && (
                  <a
                    href={project.data.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-line px-3 py-1 text-xs font-medium text-cream transition group-hover:border-accent hover:text-accent-soft"
                  >
                    Abrir demo
                  </a>
                )}
                {project.data.repoUrl && (
                  <a
                    href={project.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-line px-3 py-1 text-xs font-medium text-cream transition hover:border-accent hover:text-accent-soft"
                  >
                    Código
                  </a>
                )}
              </div>
            </div>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-cream/80">
              {project.data.summary}
            </p>
            {project.data.stack.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
                {project.data.stack.map((tech) => (
                  <li class="rounded-md border border-line bg-ink px-2.5 py-1 text-xs text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
