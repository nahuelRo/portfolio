---
import { site } from "../data/site";
---

<section
  id="educacion"
  class="section-y border-b border-line/50"
  aria-labelledby="edu-heading"
>
  <div class="mx-auto max-w-3xl px-5">
    <h2
      id="edu-heading"
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent"
    >
      Educación
    </h2>
    <div class="mt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-display text-lg font-semibold text-cream">
          {site.education.school}
        </h3>
        <p class="text-sm text-muted">{site.education.period}</p>
      </div>
      <p class="mt-1 text-sm font-medium text-accent-soft">
        {site.education.program}
      </p>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-cream/80">
        {site.education.note}
      </p>
    </div>
  </div>
</section>
